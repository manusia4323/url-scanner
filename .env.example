# External APIs
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=

# Scoring weights
WEIGHT_PREDICTION=0.5
WEIGHT_VULNERABILITY=0.3
WEIGHT_REPUTATION=0.2
DEFAULT_TOLERANCE=70

# Database
DATABASE_URL=sqlite:///./data/scanner.db

# HTTP
HTTP_TIMEOUT=10
USER_AGENT=URLScanner/1.0
MAX_CONCURRENT_SCANS=10

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
